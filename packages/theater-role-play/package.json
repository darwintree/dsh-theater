{
  "name": "@darwintree/dsh-theater-role-play",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "preview:system-prompt": "tsc -b --pretty false && node scripts/preview-system-prompt.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./director": {
      "types": "./dist/director.d.ts",
      "default": "./dist/director.js"
    },
    "./v3": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    }
  },
  "files": ["dist", "!dist/.tsbuildinfo", "preset", "scripts", "README.md"],
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@darwintree/dsh-theater": "*"
  },
  "devDependencies": {
    "@darwintree/dsh-llm-mock": "workspace:*",
    "@darwintree/dsh-stage": "workspace:*",
    "@darwintree/dsh-theater": "workspace:*",
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/cordis-plugin-include": "link:../../../deepseek-harness/vendor/include",
    "@deepseek-ai/cordis-plugin-loader": "link:../../../deepseek-harness/vendor/loader",
    "@deepseek-ai/dsh-agent": "link:../../../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-agent-default-model": "link:../../../deepseek-harness/packages/core/agent-default-model",
    "@deepseek-ai/dsh-agent-loop": "link:../../../deepseek-harness/packages/core/agent-loop",
    "@deepseek-ai/dsh-agent-presets": "link:../../../deepseek-harness/packages/preset/agent-presets",
    "@deepseek-ai/dsh-llm": "link:../../../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-session-persistence-jsonl": "link:../../../deepseek-harness/packages/session/session-persistence-jsonl",
    "@deepseek-ai/dsh-system-prompt": "link:../../../deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:../../../deepseek-harness/packages/core/tools"
  }
}
