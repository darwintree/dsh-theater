{
  "name": "@darwintree/dsh-theater-gomoku",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./single-agent": {
      "types": "./dist/single-agent.d.ts",
      "default": "./dist/single-agent.js"
    },
    "./director": {
      "types": "./dist/director.d.ts",
      "default": "./dist/director.js"
    },
    "./theater": {
      "types": "./dist/theater.d.ts",
      "default": "./dist/theater.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/*.patch.yml": "./presets/*.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "presets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/gomoku.patch.yml",
        "./presets/two-character-gomoku.patch.yml"
      ]
    }
  },
  "peerDependencies": {
    "@darwintree/dsh-stage": "*",
    "@darwintree/dsh-theater": "*",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-util-values": "*"
  },
  "peerDependenciesMeta": {
    "@darwintree/dsh-theater": {
      "optional": true
    }
  },
  "devDependencies": {
    "@darwintree/dsh-llm-mock": "workspace:*",
    "@darwintree/dsh-stage": "workspace:*",
    "@darwintree/dsh-theater": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-agent-loop": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-session-projection": "catalog:",
    "@deepseek-ai/dsh-system-prompt": "catalog:",
    "@deepseek-ai/dsh-tool-executor-native": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/dsh-util-values": "catalog:"
  }
}
