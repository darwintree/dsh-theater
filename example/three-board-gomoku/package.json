{
  "name": "@darwintree/dsh-theater-example-three-board-gomoku",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./director": {
      "types": "./dist/director.d.ts",
      "default": "./dist/director.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/*.patch.yml": "./presets/*.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "cordis.patch.yml",
    "README.md",
    "presets"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/three-board-gomoku.patch.yml"
      ]
    }
  },
  "peerDependencies": {
    "@darwintree/dsh-theater": "*",
    "@darwintree/dsh-theater-gomoku": "*",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-util-values": "*"
  },
  "devDependencies": {
    "@darwintree/dsh-llm-mock": "workspace:*",
    "@darwintree/dsh-theater": "workspace:*",
    "@darwintree/dsh-theater-gomoku": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/dsh-util-values": "catalog:"
  }
}
